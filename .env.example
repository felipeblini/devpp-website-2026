# ------------------------------------------------------------------
# DEV-PP — site
# Copie para .env e preencha. O .env NUNCA vai pro git.
# ------------------------------------------------------------------

# Para onde vão as inscrições
NUXT_INSCRICAO_TO=devpporg@gmail.com
# Remetente que aparece no e-mail (precisa ser um endereço autorizado no provedor)
NUXT_INSCRICAO_FROM="DEV-PP <devpporg@gmail.com>"

# --- Opção A: Resend (resend.com — 3.000 e-mails/mês de graça) ---
# Com domínio devpp.com.br verificado, o FROM pode ser algo@devpp.com.br
NUXT_RESEND_API_KEY=

# --- Opção B: SMTP do próprio Gmail (devpporg@gmail.com) ---
# Requer "Senha de app" (myaccount.google.com/apppasswords) com 2FA ligado.
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=devpporg@gmail.com
NUXT_SMTP_PASS=

# URL pública (canonical, OG, sitemap)
NUXT_PUBLIC_SITE_URL=https://devpp.com.br
